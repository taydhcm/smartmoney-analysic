# ════════════════════════════════════════════════════════════════
#  Streamlit Cloud Secrets – HƯỚNG DẪN DEPLOY
#  -------------------------------------------------------
#  File NÀY là template. KHÔNG chứa key thật.
#
#  Khi deploy lên streamlit.io:
#  1. Vào App → Settings → Secrets
#  2. Copy nội dung bên dưới, THAY GIÁ TRỊ bằng key thật của bạn
#  3. Lưu → App sẽ tự restart với secrets mới
#
#  Khi chạy LOCAL:
#  - Copy file này thành .streamlit/secrets.toml
#  - Điền key thật vào đó (file này đã có trong .gitignore)
# ════════════════════════════════════════════════════════════════

# ── LLM API Keys ─────────────────────────────────────────────────
# Groq (FREE) – https://console.groq.com
GROQ_API_KEY = "your_groq_api_key_here"

# OpenAI (Optional) – để trống nếu không dùng
OPENAI_API_KEY = ""

# ── Model Config (Optional) ──────────────────────────────────────
LLM_MODEL_GROQ   = "llama-3.3-70b-versatile"
LLM_MODEL_OPENAI = "gpt-4o-mini"
LLM_TEMPERATURE  = "0.3"

# ── App Config ───────────────────────────────────────────────────
APP_TITLE        = "Smart Money Detector"
CACHE_TTL_SECONDS = "900"
LOG_LEVEL        = "INFO"
