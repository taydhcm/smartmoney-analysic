# ════════════════════════════════════════════════════════════════
#  Smart Money Detector – Environment Variables
#  Copy this file to .env and fill in your values.
#  Ít nhất 1 trong 2 LLM key phải được cấu hình.
# ════════════════════════════════════════════════════════════════

# ── LLM Providers ───────────────────────────────────────────────
# Groq (FREE) – đăng ký tại https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# OpenAI (Optional) – nếu có, sẽ được ưu tiên dùng thay Groq
OPENAI_API_KEY=

# ── Model Overrides (Optional) ──────────────────────────────────
LLM_MODEL_GROQ=llama-3.3-70b-versatile
LLM_MODEL_OPENAI=gpt-4o-mini
LLM_TEMPERATURE=0.3

# ── App Config ──────────────────────────────────────────────────
APP_TITLE=Smart Money Detector
CACHE_TTL_SECONDS=900       # 15 phút
LOG_LEVEL=INFO
